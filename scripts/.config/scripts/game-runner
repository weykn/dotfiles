#!/bin/bash
set -uo pipefail

launcher=""
vdf="${HOME}/.steam/steam/steamapps/libraryfolders.vdf"

while getopts ":v:l:" opt; do
    case $opt in
        l) launcher=$OPTARG ;;
        v) vdf=$OPTARG ;;
        *) echo "usage: game-runner [-l launcher] [-v libraryfolders.vdf]" >&2; exit 1 ;;
    esac
done

if [ ! -e "$vdf" ]; then
    echo "unable to read $vdf - file does not exist" >&2
    exit 1
fi

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/game-runner/icons"
mkdir -p "$CACHE"

catalogue=$(STEAM_VDF="$vdf" STEAM_CACHE="$CACHE" python3 - <<'PY'
import os, re, struct, glob, subprocess, shutil

VDF   = os.environ["STEAM_VDF"]
CACHE = os.environ["STEAM_CACHE"]
HOME  = os.path.expanduser("~")
MAGICK = shutil.which("magick") or shutil.which("convert")

SKIP = re.compile(r"^(Proton\b|Steam Linux Runtime|Steamworks Common Redist)", re.I)


def icon_png(appid, source):
    if not source or not os.path.exists(source):
        return ""
    if source.lower().endswith(".png"):
        return source
    if not MAGICK:
        return ""
    out = os.path.join(CACHE, f"{appid}.png")
    if not os.path.exists(out) or os.path.getmtime(out) < os.path.getmtime(source):
        try:
            subprocess.run([MAGICK, source, out], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (subprocess.CalledProcessError, OSError):
            return ""
    return out if os.path.exists(out) else ""


def steam_icon(libs, appid):
    for lib in libs:
        d = os.path.join(lib, "appcache", "librarycache", str(appid))
        for f in glob.glob(os.path.join(d, "*.jpg")):
            if re.fullmatch(r"[0-9a-f]{40}\.jpg", os.path.basename(f)):
                return f
        for name in (f"{appid}_icon.jpg", "library_600x900.jpg", "header.jpg"):
            p = os.path.join(d, name)
            if os.path.exists(p):
                return p
    return ""


libs = re.findall(r'"path"\s*"([^"]+)"', open(VDF, encoding="utf-8", errors="replace").read())
libs = list(dict.fromkeys(libs + [os.path.join(HOME, ".local/share/Steam"),
                                  os.path.join(HOME, ".steam/steam")]))

games = {}

for lib in libs:
    for acf in glob.glob(os.path.join(lib, "steamapps", "*.acf")):
        try:
            text = open(acf, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        appid = re.search(r'"appid"\s*"(\d+)"', text)
        name  = re.search(r'"name"\s*"([^"]*)"', text)
        if not appid or not name or SKIP.match(name.group(1)):
            continue
        appid, name = appid.group(1), name.group(1)
        games[appid] = (name, icon_png(appid, steam_icon(libs, appid)))

for sc in glob.glob(os.path.join(HOME, ".local/share/Steam/userdata/*/config/shortcuts.vdf")) \
        + glob.glob(os.path.join(HOME, ".steam/steam/userdata/*/config/shortcuts.vdf")):
    try:
        blob = open(sc, "rb").read()
    except OSError:
        continue
    for m in re.finditer(rb"\x02appid\x00(....)\x01AppName\x00([^\x00]*)\x00"
                         rb"\x01Exe\x00([^\x00]*)\x00\x01StartDir\x00([^\x00]*)\x00"
                         rb"\x01icon\x00([^\x00]*)\x00", blob, re.S):
        shortid  = struct.unpack("<I", m.group(1))[0]
        name     = m.group(2).decode("utf-8", "replace").strip()
        startdir = m.group(4).decode("utf-8", "replace").strip()
        icon     = m.group(5).decode("utf-8", "replace").strip()
        if not name:
            continue
        if re.fullmatch(r"[^/\\]+\.exe", name, re.I):
            folder = os.path.basename(startdir.rstrip("/\\"))
            name = folder if folder else name[:-4]
        rungameid = (shortid << 32) | 0x02000000
        games[str(rungameid)] = (name, icon_png(shortid, icon) or "input-gaming")

for gid, (name, icon) in sorted(games.items(), key=lambda kv: kv[1][0].lower()):
    print(f"{name}\t{icon}\t{gid}")
PY
)

[ -z "$catalogue" ] && { echo "no games found" >&2; exit 1; }

if [ -z "$launcher" ]; then
    count=$(printf '%s\n' "$catalogue" | wc -l)
    [ "$count" -gt 12 ] && count=12
    glyph=$(printf '\uf11b')
    launcher="fuzzel --dmenu --prompt '$glyph  ' --placeholder 'Search games' --lines $count"
fi

chosen=$(printf '%s\n' "$catalogue" | awk -F'\t' '{
    if ($2 != "") printf "%s\0icon\x1f%s\n", $1, $2; else print $1
}' | eval "$launcher" | head -1)

[ -z "$chosen" ] && exit 2

id=$(printf '%s\n' "$catalogue" | awk -F'\t' -v want="$chosen" '$1 == want { print $3; exit }')
id=${id//[^0-9]/}
[ -z "$id" ] && exit 2

exec steam "steam://rungameid/$id"
