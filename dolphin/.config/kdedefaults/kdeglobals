# KDE defaults for Dolphin (and any other KF6 app) outside Plasma.
#
# Not ~/.config/kdeglobals: that one is runtime state KDE apps write to.
# hyprland.lua prepends ~/.config/kdedefaults to XDG_CONFIG_DIRS, so KConfig
# reads this file underneath it — the same trick Plasma uses.
#
# Colors below are Hyprland Blue (~/.local/share/color-schemes/HyprlandBlue.colors),
# the foot/mako/waybar palette; KColorScheme reads the palette straight from
# these groups, so they have to be copied in here, not just named.

[General]
ColorScheme=HyprlandBlue
# Dolphin's "Open Terminal Here" (Shift+F4) and every other KDE terminal action
TerminalApplication=foot
TerminalService=foot.desktop

[Icons]
Theme=breeze-dark

[KDE]
widgetStyle=Breeze
contrast=4

