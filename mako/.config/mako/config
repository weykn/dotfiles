# mako — notifications, blue theme (replaces dunst/notify on X11)
font=JetBrainsMono Nerd Font 11
background-color=#1b1e22e6
text-color=#f0f4fa
border-color=#6ea8de
progress-color=over #3b5a7a
border-size=2
border-radius=10
padding=12
margin=10
width=360
height=140
default-timeout=5000
anchor=top-right
layer=overlay
icons=1
max-icon-size=48
markup=1
actions=1

[urgency=low]
border-color=#5d6b7a
default-timeout=3000

[urgency=critical]
border-color=#d0546e
default-timeout=0
